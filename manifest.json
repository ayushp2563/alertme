{
  "manifest_version": 3,
  "name": "Alert Me",
  "version": "1.3.0",
  "description": "Monitor websites and get notified when meaningful content changes.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Alert Me"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://id-preview--51a5cb45-d624-45a0-a8d9-8e823d3a5f49.lovable.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/browser.js", "content/picker.js"],
      "css": ["content/picker.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ontario.ca/*",
        "https://ontario.ca/*",
        "https://www.canada.ca/*"
      ],
      "js": ["lib/browser.js", "lib/draw-parser.js", "content/draws.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "alert-me@notifications",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}